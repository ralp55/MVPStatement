<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="4-create-passport-table" author="yourname">
        <createTable tableName="passport">
            <column name="pasport_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="series" type="varchar(4)">
                <constraints nullable="false"/>
            </column>
            <column name="number_passport" type="varchar(6)">
                <constraints nullable="false"/>
            </column>
            <column name="isuue_branch" type="varchar(255)"/>
            <column name="issue_date" type="date"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
