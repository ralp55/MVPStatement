<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="6-create-statement-status-history-table" author="yourname">
        <createTable tableName="statement_status_history">
            <column name="id_statement_status_history" type="bigserial">
                <constraints primaryKey="true" nullable="false" />
            </column>

            <column name="status" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="change_time" type="timestamp">
                <constraints nullable="false"/>
            </column>

            <column name="change_type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="statement_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_status_history_statement"
                baseTableName="statement_status_history"
                baseColumnNames="statement_id"
                referencedTableName="statement"
                referencedColumnNames="statement_id"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
