<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="2-create-employment-table" author="yourname">
        <createTable tableName="employment">
            <column name="employement_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employment_status" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="employer_inn" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="salary" type="numeric(15,2)">
                <constraints nullable="true"/>
            </column>
            <column name="position" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="work_experience_total" type="integer">
                <constraints nullable="true"/>
            </column>
            <column name="work_experience_current" type="integer">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
