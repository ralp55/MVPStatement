<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="0-create-uuid-extension" author="yourname" runOnChange="true" runAlways="true">
        <sql>CREATE EXTENSION IF NOT EXISTS "uuid-ossp";</sql>
    </changeSet>

    <changeSet id="1-create-credit-table" author="yourname">
        <createTable tableName="credit">
            <column name="credit_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="numeric(19,2)">
                <constraints nullable="true"/>
            </column>
            <column name="term" type="integer">
                <constraints nullable="true"/>
            </column>
            <column name="monthly_payment" type="numeric(19,2)">
                <constraints nullable="true"/>
            </column>
            <column name="rate" type="numeric(5,2)">
                <constraints nullable="true"/>
            </column>
            <column name="psk" type="numeric(19,2)">
                <constraints nullable="true"/>
            </column>
            <column name="payment_shedule" type="jsonb">
                <constraints nullable="true"/>
            </column>
            <column name="insurance_enabled" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="salary_client" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="credit_status" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>


    </changeSet>

</databaseChangeLog>
